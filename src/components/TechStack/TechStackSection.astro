---
import { ToolCase } from "@lucide/astro";
import { useTranslations, type Lang } from "../../i18n";
import RadarChart from "./RadarChart.astro";
import { engineeringSkills, practicesSkills } from "../../data/skills";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="skills" class="section-container section-padding">
    <h2 class="section-title" data-animate="fade-up">
        <ToolCase class="section-title-icon" size={24} />
        {t("skills.title")}
    </h2>

    <div class="radars-container" data-animate="fade-up">
        <RadarChart data={engineeringSkills} />
        <RadarChart data={practicesSkills} />
    </div>

    <p class="skills-hint" data-animate="fade-up">
        {t("skills.hint")}
    </p>

    <!-- Tooltip element -->
    <div id="skill-tooltip" class="skill-tooltip" role="tooltip"></div>
</section>

<style>
    .radars-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        justify-items: center;
        margin-top: 2rem;
    }

    .skills-hint {
        text-align: center;
        color: rgb(var(--color-text-muted));
        font-size: 0.875rem;
        margin-top: 2rem;
    }

    @media (max-width: 768px) {
        .radars-container {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
    }
</style>

<script>
    function initTooltips() {
        const tooltip = document.getElementById("skill-tooltip");
        if (!tooltip) return;

        const points = document.querySelectorAll(".radar-point");
        const labels = document.querySelectorAll(".radar-label");

        // State management
        let currentElement: HTMLElement | null = null;
        let hideTimeout: number | null = null;
        let isTooltipHovered = false;
        const isMobile =
            window.matchMedia("(max-width: 768px)").matches ||
            "ontouchstart" in window;

        function showTooltip(el: HTMLElement) {
            // Clear any pending hide
            if (hideTimeout) {
                clearTimeout(hideTimeout);
                hideTimeout = null;
            }

            currentElement = el;

            const name = el.getAttribute("data-name") || "";
            const level = el.getAttribute("data-level") || "0";
            const techsStr = el.getAttribute("data-techs");
            let techs: string[] = [];

            if (techsStr) {
                try {
                    techs = JSON.parse(techsStr);
                } catch {
                    // Parse error
                }
            }

            let html =
                '<div class="tooltip-header"><strong>' +
                name +
                '</strong><span class="tooltip-level">Level ' +
                level +
                '/5</span></div><div class="tooltip-techs">';

            for (const tech of techs) {
                html += '<span class="tooltip-tech">' + tech + "</span>";
            }

            html += "</div>";

            tooltip.innerHTML = html;

            // Position tooltip ABOVE the element with gap
            const rect = el.getBoundingClientRect();

            // Get tooltip dimensions BEFORE positioning
            tooltip.style.visibility = "hidden";
            tooltip.classList.add("visible");
            const tooltipRect = tooltip.getBoundingClientRect();
            tooltip.classList.remove("visible");
            tooltip.style.visibility = "";

            const gap = 12;
            let left = rect.left + rect.width / 2;
            let top = rect.top - tooltipRect.height - gap;

            // Ensure tooltip stays within viewport horizontally
            const tooltipWidth = tooltipRect.width || 200;
            if (left - tooltipWidth / 2 < 10) {
                left = tooltipWidth / 2 + 10;
            } else if (left + tooltipWidth / 2 > window.innerWidth - 10) {
                left = window.innerWidth - tooltipWidth / 2 - 10;
            }

            // If tooltip would go above viewport, position it below the element
            if (top < 10) {
                top = rect.bottom + gap;
            }

            tooltip.style.left = left + "px";
            tooltip.style.top = top + "px";
            tooltip.classList.add("visible");
        }

        function hideTooltip() {
            // Debounce hide to prevent flickering
            if (hideTimeout) {
                clearTimeout(hideTimeout);
            }

            hideTimeout = window.setTimeout(() => {
                if (!isTooltipHovered) {
                    tooltip.classList.remove("visible");
                    currentElement = null;
                }
            }, 150);
        }

        function forceHideTooltip() {
            if (hideTimeout) {
                clearTimeout(hideTimeout);
                hideTimeout = null;
            }
            tooltip.classList.remove("visible");
            currentElement = null;
            isTooltipHovered = false;
        }

        // Tooltip hover handlers - keep visible while hovering tooltip itself
        tooltip.addEventListener("mouseenter", () => {
            isTooltipHovered = true;
            if (hideTimeout) {
                clearTimeout(hideTimeout);
                hideTimeout = null;
            }
        });

        tooltip.addEventListener("mouseleave", () => {
            isTooltipHovered = false;
            hideTooltip();
        });

        // Helper to find matching point for a label (by data-name)
        function getMatchingPoint(label: HTMLElement): SVGCircleElement | null {
            const name = label.getAttribute("data-name");
            if (!name) return null;
            const container = label.closest(".radar-container");
            if (!container) return null;
            return container.querySelector(
                `.radar-point[data-name="${name}"]`
            ) as SVGCircleElement | null;
        }

        // Helper to activate/deactivate point
        function activatePoint(point: SVGCircleElement | null) {
            if (point) point.classList.add("active");
        }

        function deactivatePoint(point: SVGCircleElement | null) {
            if (point) point.classList.remove("active");
        }

        // Attach events to points
        points.forEach((el) => {
            const element = el as HTMLElement;

            if (isMobile) {
                element.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (currentElement === element) {
                        forceHideTooltip();
                    } else {
                        showTooltip(element);
                    }
                });
            } else {
                element.addEventListener("mouseenter", () => {
                    showTooltip(element);
                });
                element.addEventListener("mouseleave", () => {
                    hideTooltip();
                });
            }
        });

        // Attach events to labels with point synchronization
        labels.forEach((el) => {
            const element = el as HTMLElement;
            const matchingPoint = getMatchingPoint(element);

            if (isMobile) {
                element.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    if (currentElement === element) {
                        forceHideTooltip();
                        deactivatePoint(matchingPoint);
                    } else {
                        // Deactivate all points first
                        points.forEach((p) => p.classList.remove("active"));
                        showTooltip(element);
                        activatePoint(matchingPoint);
                    }
                });
            } else {
                element.addEventListener("mouseenter", () => {
                    showTooltip(element);
                    activatePoint(matchingPoint);
                });
                element.addEventListener("mouseleave", () => {
                    hideTooltip();
                    deactivatePoint(matchingPoint);
                });
            }

            // Keyboard accessibility
            element.addEventListener("focus", () => {
                showTooltip(element);
                activatePoint(matchingPoint);
            });

            element.addEventListener("blur", () => {
                hideTooltip();
                deactivatePoint(matchingPoint);
            });
        });

        // Mobile: tap outside to close
        if (isMobile) {
            document.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                if (
                    !target.closest(".radar-point") &&
                    !target.closest(".radar-label") &&
                    !target.closest(".skill-tooltip")
                ) {
                    forceHideTooltip();
                    // Deactivate all points
                    points.forEach((p) => p.classList.remove("active"));
                }
            });
        }
    }

    // Initialize on load
    initTooltips();

</script>
