---
import { useTranslations, type Lang } from '../i18n';
import { GithubIcon, LinkedinIcon, MailIcon } from '../assets/icons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '#about', label: t('nav.about') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: t('nav.projects') },
  { href: '#contact', label: t('nav.contact') },
];

const socialLinks = [
  { href: 'https://github.com/belcaik', icon: GithubIcon, label: 'GitHub' },
  { href: 'https://linkedin.com/in/pedrogarridodev', icon: LinkedinIcon, label: 'LinkedIn' },
  { href: 'mailto:pedrogarrido.dev@gmail.com', icon: MailIcon, label: 'Email' },
];
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-top">
      <div class="footer-section">
        <h3 class="footer-brand">Pedro Garrido</h3>
        <p class="footer-tagline">Software Engineer & DevOps Enthusiast</p>
      </div>

      <nav class="footer-nav" aria-label="Footer Navigation">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-section">
        <h4 class="footer-heading">Connect</h4>
        <div class="social-links">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label={social.label}
            >
              <social.icon />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} Pedro Garrido. All rights reserved.
      </p>
      <p class="built-with">
        {t('footer.builtWith')}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    padding: 3rem 1rem 2rem;
    margin-top: 6rem;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 3rem;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .footer-tagline {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin: 0;
    max-width: 300px;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--primary-color);
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    color: white;
    transform: translateY(-2px);
  }

  .social-link :global(svg) {
    width: 20px;
    height: 20px;
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .copyright,
  .built-with {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin: 0;
  }

  .built-with {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 2.5rem 1rem 1.5rem;
      margin-top: 4rem;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-section {
      text-align: center;
      align-items: center;
    }

    .footer-nav {
      align-items: center;
    }

    .footer-tagline {
      max-width: 100%;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      padding-top: 1.5rem;
    }
  }
</style>
