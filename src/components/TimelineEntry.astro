---
import type { Lang } from "../i18n";
import type { TimelineEntry } from "../utils";
import { getSemanticDuration } from "../utils/dateParser";
import { Briefcase, GraduationCap } from "@lucide/astro";

interface Props {
    entry: TimelineEntry;
    position: "left" | "right";
    lang: Lang;
}

const { entry, position, lang } = Astro.props;
const isPosition = entry.type === "position";
const duration = getSemanticDuration(entry.parsedDates, lang);
---

<article class={`entry entry--${entry.type}`}>
    <!-- Icon circle on the right side (spine side) -->
    <div class="entry-icon-wrapper">
        {
            isPosition ? (
                <Briefcase class="w-5 h-5 text-primary" size={20} />
            ) : (
                <GraduationCap class="w-5 h-5 text-primary" size={20} />
            )
        }
    </div>

    <!-- Card Content -->
    <div class="entry-card">
        <div class="mb-2">
            <h4 class="text-base font-semibold text-text m-0 leading-tight">
                {entry.title}
            </h4>
            <p class="text-sm mt-1 mb-0 leading-normal">
                <span class="text-primary font-medium">{entry.subtitle}</span>
                {
                    entry.via && (
                        <span class="text-text-muted font-normal">
                            {" "}
                            {entry.via}
                        </span>
                    )
                }
            </p>
        </div>

        <div class="entry-meta">
            <time class="text-xs text-text-muted">{entry.dateString}</time>
            <span class="text-xs text-text-subtle">({duration})</span>
            {entry.status && <span class="entry-status">{entry.status}</span>}
        </div>

        {
            entry.location && (
                <p class="text-xs text-text-subtle m-0 mb-3">
                    {entry.location}
                </p>
            )
        }

        {
            entry.description && entry.description.length > 0 && (
                <ul class="entry-description">
                    {entry.description.map((item) => (
                        <li>{item}</li>
                    ))}
                </ul>
            )
        }

        {
            entry.honors && (
                <p class="text-sm text-text-muted my-2 italic">
                    {entry.honors}
                </p>
            )
        }

        {
            entry.tech && entry.tech.length > 0 && (
                <div class="entry-tech">
                    {entry.tech.map((tech) => (
                        <span class="tech-tag tech-tag-sm">{tech}</span>
                    ))}
                </div>
            )
        }
    </div>
</article>

<style>
    .entry {
        @apply relative flex w-full;
    }

    /* Icon wrapper on right side (next to spine) */
    .entry-icon-wrapper {
        @apply absolute top-6 w-10 h-10 rounded-full bg-surface border-[3px] border-primary flex items-center justify-center z-10;
        right: -1.25rem;
    }

    /* Card styles - always left-aligned */
    .entry-card {
        @apply w-full p-5 bg-surface border border-border rounded-card transition-all duration-200 text-left mr-6;
    }

    .entry-card:hover {
        @apply -translate-y-0.5;
        box-shadow: 0 8px 25px -5px rgba(0, 0, 0, 0.1);
    }

    .entry-meta {
        @apply flex items-center gap-2 mb-2 flex-wrap justify-start;
    }

    .entry-status {
        @apply text-[0.7rem] font-medium py-0.5 px-2.5 rounded-full bg-primary/15 text-primary;
    }

    .entry-description {
        @apply text-sm text-text-muted my-3 leading-relaxed pl-4 pr-0;
    }

    .entry-description li {
        @apply mb-1.5 last:mb-0;
    }

    .entry-tech {
        @apply flex flex-wrap gap-1.5 mt-3 justify-start;
    }

    /* Mobile: spine moves to left, icon on left */
    @media (max-width: 768px) {
        .entry-icon-wrapper {
            right: auto;
            left: -1.25rem;
        }

        .entry-card {
            @apply ml-6 mr-0;
        }
    }
</style>
