---
import { useTranslations, type Lang } from "../i18n";
import { UserCircle } from "@lucide/astro";
import { getProfile } from "../data/profile";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { summary } = getProfile(lang);
---

<section id="about" class="section-container section-padding ">
  <h2 class="section-title" data-animate="fade-up">
    <UserCircle class="section-title-icon" size={32} />
    {t("about.title")}
  </h2>

  <div data-animate="fade-up">
    {
      summary.site.map((paragraph) => (
        <p class="text-[1.125rem] md:text-base leading-relaxed text-text-muted m-0">{paragraph}</p>
      ))
    }
  </div>
</section>
