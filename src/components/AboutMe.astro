---
import { useTranslations, type Lang } from "../i18n";
import { CredIcon } from "../assets/icons";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="about">
  <h3 class="about-title"><CredIcon  class="about-icon"/> {t("about.title")}</h3>
  {
    (t("about.paragraphs") as string[]).map((paragraph) => (
      <>
        <p>{paragraph}</p>
        <br />
      </>
    ))
  }
</section>

<style>
  .about {
  }
  .about-title {
   
  }
