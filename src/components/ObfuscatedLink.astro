---
/**
 * Obfuscated Link Component
 * Protects email links from scrapers by encoding the href and decoding client-side
 */
interface Props {
  email: string;
  class?: string;
  ariaLabel?: string;
}

const { email, class: className = '', ariaLabel = 'Send email' } = Astro.props;

// Encode the entire email
const encodedEmail = Buffer.from(email).toString('base64');
const uniqueId = `link-${Math.random().toString(36).substring(2, 9)}`;
---

<a
  href="#contact"
  class={`obfuscated-link ${className}`}
  data-e={encodedEmail}
  id={uniqueId}
  aria-label={ariaLabel}
>
  <slot />
</a>

<script define:vars={{ uniqueId, encodedEmail }}>
  (function() {
    const el = document.getElementById(uniqueId);
    if (!el) return;

    // Decode and set proper mailto href
    const email = atob(encodedEmail);
    el.href = 'mailto:' + email;
  })();
</script>
