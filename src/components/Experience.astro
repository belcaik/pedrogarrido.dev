---
import { useTranslations, type Lang } from '../i18n';
import { TimelineIcon } from '../assets/icons';
import TimelineEntry from './TimelineEntry.astro';
import en from '../assets/translations/en.json';
import es from '../assets/translations/es.json';
import { createTimelineContext, type Job, type School } from '../utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = { en, es } as const;
const jobs = translations[lang].experience.jobs as Job[];
const schools = translations[lang].education.items as School[];

const { allEntries, slots, totalRows } = createTimelineContext(jobs, schools, lang);
---

<section id="experience" class="experience">
  <h3 class="experience-title">
    <TimelineIcon class="experience-icon" /> {t("experience.title")} & {t("education.title")}
  </h3>

  <!-- Desktop: Bifurcated timeline with temporal alignment -->
  <div class="timeline-desktop" style={`--total-rows: ${totalRows}`}>
    <!-- Render entries with explicit grid-row assignments based on temporal slots -->
    {slots.map((slot) => (
      <>
        {slot.left && (
          <div class="entry-slot entry-slot--left" style={`grid-row: ${slot.row}`}>
            <TimelineEntry entry={slot.left} position="left" lang={lang} />
          </div>
        )}
        {slot.right && (
          <div class="entry-slot entry-slot--right" style={`grid-row: ${slot.row}`}>
            <TimelineEntry entry={slot.right} position="right" lang={lang} />
          </div>
        )}
      </>
    ))}

    <!-- Center spine: spans all rows -->
    <div class="timeline-spine"></div>
  </div>

  <!-- Mobile: Linear timeline -->
  <div class="timeline-mobile">
    <div class="timeline-spine"></div>
    <div class="timeline-column">
      {allEntries.map((entry) => (
        <TimelineEntry entry={entry} position="right" lang={lang} />
      ))}
    </div>
  </div>
</section>

<style>
  .experience {
    padding: 2rem 0;
  }

  .experience-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.75rem;
    font-weight: 600;
    color: rgb(var(--color-text));
    margin-bottom: 2.5rem;
  }

  .experience-icon {
    width: 2rem;
    height: 2rem;
    color: rgb(var(--color-primary));
  }

  /* ================================
     DESKTOP LAYOUT
     ================================ */
  .timeline-desktop {
    --column-gap: 4rem;
    display: grid;
    grid-template-columns: 1fr 2px 1fr;
    grid-template-rows: repeat(var(--total-rows), auto);
    gap: 1.5rem var(--column-gap);
    position: relative;
    align-items: start;
  }

  .timeline-mobile {
    display: none;
  }

  /* Entry slot wrappers - pass column-gap to child entries */
  .entry-slot {
    display: flex;
    width: 100%;
    --column-gap: inherit;
    align-items: center;
  }

  .entry-slot--left {
    grid-column: 1;
    justify-content: flex-end;
  }

  .entry-slot--right {
    grid-column: 3;
    justify-content: flex-start;
  }

  /* Desktop spine: centered in column 2, spanning all rows */
  .timeline-desktop .timeline-spine {
    grid-column: 2;
    grid-row: 1 / -1;
    position: relative;
    width: 2px;
    justify-self: center;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(var(--color-border)) 2%,
      rgb(var(--color-border)) 98%,
      transparent 100%
    );
  }

  /* ================================
     MOBILE LAYOUT
     ================================ */
  @media (max-width: 768px) {
    .timeline-desktop {
      display: none;
    }

    .timeline-mobile {
      display: grid;
      grid-template-columns: 2px 1fr;
      gap: 0 1.5rem;
      padding-left: 0.5rem;
    }

    .timeline-mobile .timeline-spine {
      grid-column: 1;
      grid-row: 1;
      width: 2px;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgb(var(--color-border)) 2%,
        rgb(var(--color-border)) 98%,
        transparent 100%
      );
    }

    .timeline-mobile .timeline-column {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>
