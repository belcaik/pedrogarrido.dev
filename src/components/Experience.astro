---
import { useTranslations, type Lang } from "../i18n";
import { Download, CalendarDays } from "@lucide/astro";
import TimelineEntry from "./TimelineEntry.astro";
import en from "../assets/translations/en.json";
import es from "../assets/translations/es.json";
import { createTimelineContext, type Job, type School } from "../utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = { en, es } as const;
const jobs = translations[lang].experience.jobs as Job[];
const schools = translations[lang].education.items as School[];

const { slots, totalRows } = createTimelineContext(jobs, schools, lang);
---

<section id="experience" class="section-container py-8">
  <h3 class="section-title">
    <CalendarDays class="section-title-icon" size={32} />
    {t("experience.title")} & {t("education.title")}
  </h3>

  <a href="/assets/cv/fullstack.pdf" class="btn-cta w-fit" rel="nofollow noindex" download aria-label="Download resume">
    <Download class="btn-icon" size={20} />
    <span>{t("about.downloadResume")}</span>
  </a>

  <!-- Desktop: Alternating timeline -->
  <div class="timeline" style={`--total-rows: ${totalRows}`}>
    <div class="timeline-spine"></div>

    {slots.map((slot) => (
      <div
        class={`timeline-slot timeline-slot--${slot.position}`}
        style={`grid-row: ${slot.row}`}
      >
        <TimelineEntry entry={slot.entry} position={slot.position} lang={lang} />
      </div>
    ))}
  </div>

  <!-- Mobile: Linear timeline -->
  <div class="timeline-mobile">
    <div class="timeline-spine"></div>
    <div class="timeline-entries">
      {slots.map((slot) => (
        <TimelineEntry entry={slot.entry} position="right" lang={lang} />
      ))}
    </div>
  </div>
</section>

<style>
  /* Desktop: Alternating timeline */
  .timeline {
    display: grid;
    grid-template-columns: 1fr 4px 1fr;
    grid-template-rows: repeat(var(--total-rows), auto);
    gap: 2rem 0;
    position: relative;
    margin-top: 2rem;
  }

  .timeline-mobile {
    display: none;
  }

  /* Central spine */
  .timeline .timeline-spine {
    grid-column: 2;
    grid-row: 1 / -1;
    @apply w-1 justify-self-center relative;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(var(--color-border)) 2%,
      rgb(var(--color-border)) 98%,
      transparent 100%
    );
  }

  /* Slot positioning */
  .timeline-slot {
    @apply flex items-start;
  }

  .timeline-slot--left {
    grid-column: 1;
    @apply justify-end pr-6;
  }

  .timeline-slot--right {
    grid-column: 3;
    @apply justify-start pl-6;
  }

  /* Mobile: Linear timeline */
  @media (max-width: 768px) {
    .timeline {
      display: none;
    }

    .timeline-mobile {
      display: grid;
      grid-template-columns: 4px 1fr;
      @apply gap-x-4 mt-8 pl-2;
    }

    .timeline-mobile .timeline-spine {
      grid-column: 1;
      grid-row: 1;
      @apply w-1;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgb(var(--color-border)) 1%,
        rgb(var(--color-border)) 99%,
        transparent 100%
      );
    }

    .timeline-mobile .timeline-entries {
      grid-column: 2;
      grid-row: 1;
      @apply flex flex-col gap-6;
    }
  }
</style>
