---
import { useTranslations, type Lang } from '../i18n';
import { TimelineIcon } from '../assets/icons';
import en from '../assets/translations/en.json';
import es from '../assets/translations/es.json';

interface Job {
  company: string;
  via?: string;
  position: string;
  date: string;
  location: string;
  description: string[];
  tech: string[];
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translations = { en, es } as const;
const jobs = translations[lang].experience.jobs as Job[];
---

<section id="experience" class="experience">
  <h3 class="experience-title"><TimelineIcon class="experience-icon" /> {t("experience.title")}</h3>
  <div class="timeline">
    {jobs.map((job: Job) => (
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="job-header">
            <h4 class="job-title">{job.position}</h4>
            <span class="job-date">{job.date}</span>
          </div>
          <p class="job-company">
            {job.company} {job.via && <span class="job-via">{job.via}</span>}
          </p>
          <p class="job-location">{job.location}</p>
          <ul class="job-description">
            {job.description.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
          <div class="job-tech">
            {job.tech.map((tech: string) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .experience {
    margin-top: 4rem;
  }

  .experience-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }

  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline::before {
    position: absolute;
    left: 0.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-item {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -1.75rem;
    top: 0.25rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgb(var(--gradient-color));
    border: 2px solid rgb(var(--color-text));  
    box-shadow: 0 0 0 2px rgb(var(--gradient-color));
  }

  .timeline-content {
        /* 1. Add a semi-transparent background to the element */
    background-color: rgba(var(--color-background), 0.1); 
    
    /* 2. Apply the blur effect to the background behind the element */
    backdrop-filter: blur(5em); 
    
    /* Optional: for older browser compatibility */
    -webkit-backdrop-filter: blur(5em); 
    
    /* Add padding/size for visibility */

    border-radius: 0.5rem;
    padding: 1.25rem;
    border: 1px solid rgb(var(--color-border));
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .job-title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
    color: rgb(var(--color-text));
  }

  .job-date {
    font-size: 0.875rem;
    color: rgb(var(--color-text-muted)) ;
    white-space: nowrap;
  }

  .job-company {
    font-size: 1rem;
    font-weight: 500;
    color: rgb(var(--color-primary));
    margin: 0.25rem 0;
  }

  .job-via {
    font-weight: 400;
    color: rgb(var(--color-text-muted));
  }

  .job-location {
    font-size: 0.875rem;
    color: rgb(var(--color-text-muted));
    margin: 0 0 1rem 0;
  }

  .job-description {
    margin: 0 0 1rem 0;
    padding-left: 1.25rem;
    list-style-type: disc;
  }

  .job-description li {
    font-size: 0.9rem;
    color: rgb(var(--color-text));
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .job-description li:last-child {
    margin-bottom: 0;
  }

  .job-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  
  .tech-tag {
    background: rgba(var(--color-surface)/ 0.5);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    color: rgb(var(--color-tag-text));
    border-radius: 0.25rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .job-header {
      flex-direction: column;
    }
  }
</style>
