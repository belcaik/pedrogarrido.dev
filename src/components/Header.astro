---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getProfile, getSystems } from "../data/profile";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { identity } = getProfile(lang);
const firstSystem = getSystems(lang)[0];
---

<header class="bar">
  <a class="home" href={`/${lang}/`}>{identity.name}</a>
  <ul class="bar-nav">
    <li><a href={`#${firstSystem.id}`}>{t("nav.systems")}</a></li>
    <li><a href="#projects">{t("nav.projects")}</a></li>
    <li><a href="#contact">{t("nav.contact")}</a></li>
    <li>
      <LanguageSwitcher lang={lang} />
    </li>
    <li>
      <button
        class="theme-btn"
        id="theme-btn"
        type="button"
        hidden
        data-label-dark={t("nav.themeDark")}
        data-label-light={t("nav.themeLight")}
        data-aria-dark={t("nav.themeToDark")}
        data-aria-light={t("nav.themeToLight")}
      ></button>
    </li>
  </ul>
</header>

<script>
  // The button only appears with JavaScript; without it the page stays in the OS theme.
  const button = document.getElementById("theme-btn") as HTMLButtonElement | null;

  if (button) {
    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: dark)");

    const currentTheme = () => root.dataset.theme || (media.matches ? "dark" : "light");

    const sync = () => {
      const isDark = currentTheme() === "dark";
      button.textContent = isDark ? button.dataset.labelLight! : button.dataset.labelDark!;
      button.setAttribute("aria-label", isDark ? button.dataset.ariaLight! : button.dataset.ariaDark!);
    };

    button.hidden = false;
    button.addEventListener("click", () => {
      const next = currentTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("pg-theme", next);
      } catch {
        // Storage can be blocked; the choice then lasts for this page only.
      }
      sync();
    });
    media.addEventListener("change", sync);
    sync();
  }
</script>
