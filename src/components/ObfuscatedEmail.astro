---
/**
 * Obfuscated Email Component
 * Protects email from scrapers by encoding it and decoding client-side
 */
interface Props {
  email: string;
  class?: string;
  showIcon?: boolean;
}

const { email, class: className = '', showIcon = false } = Astro.props;

// Split and encode email parts
const [user, domain] = email.split('@');
const encodedUser = Buffer.from(user).toString('base64');
const encodedDomain = Buffer.from(domain).toString('base64');
const uniqueId = `email-${Math.random().toString(36).substring(2, 9)}`;
---

<span
  class={`obfuscated-email inline ${className}`}
  data-u={encodedUser}
  data-d={encodedDomain}
  id={uniqueId}
>
  <noscript>Enable JavaScript to view email</noscript>
  <span class="text-text-muted italic">[email protected]</span>
</span>

<script define:vars={{ uniqueId, encodedUser, encodedDomain }}>
  (function() {
    const el = document.getElementById(uniqueId);
    if (!el) return;

    // Decode the email
    const user = atob(encodedUser);
    const domain = atob(encodedDomain);
    const email = user + '@' + domain;

    // Create the mailto link
    const link = document.createElement('a');
    link.href = 'mailto:' + email;
    link.textContent = email;
    link.className = 'email-link decoded-email';

    // Replace placeholder
    el.innerHTML = '';
    el.appendChild(link);
  })();
</script>
