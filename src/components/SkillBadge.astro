---
import type { SkillCategory } from '../utils/skills';

interface Props {
  name: string;
  category: SkillCategory;
}

const { name, category } = Astro.props;

const categoryColors: Record<SkillCategory, string> = {
  languages: 'badge--languages',
  backend: 'badge--backend',
  frontend: 'badge--frontend',
  databases: 'badge--databases',
  devops: 'badge--devops',
  tools: 'badge--tools',
  ai: 'badge--ai'
};
---

<span class={`skill-badge ${categoryColors[category]}`}>
  {name}
</span>

<style>
  .skill-badge {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid;
    background: rgb(var(--color-primary) / 0.05);
    font-size: 0.875rem;
    font-family: var(--font-body);
    white-space: nowrap;
    color: rgb(var(--color-text));
    transition: all 150ms var(--ease-out, ease-out);
    cursor: default;
  }

  .skill-badge:hover {
    background: rgb(var(--color-primary) / 0.12);
    transform: scale(1.05);
  }

  /* Category-specific border colors - brand-aligned */
  .badge--languages {
    border-color: rgb(88 166 255 / 0.3); /* Sky Blue */
  }

  .badge--backend {
    border-color: rgb(0 212 170 / 0.3); /* Cyber Teal */
  }

  .badge--frontend {
    border-color: rgb(192 132 252 / 0.3); /* Soft Violet */
  }

  .badge--databases {
    border-color: rgb(251 191 36 / 0.3); /* Signal Amber */
  }

  .badge--devops {
    border-color: rgb(0 168 138 / 0.3); /* Teal Dim */
  }

  .badge--tools {
    border-color: rgb(156 163 175 / 0.3); /* text-secondary */
  }

  .badge--ai {
    border-color: rgb(88 166 255 / 0.3); /* Sky Blue */
  }
</style>
