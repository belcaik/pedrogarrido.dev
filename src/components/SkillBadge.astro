---
import type { SkillCategory } from '../utils/skills';

interface Props {
  name: string;
  category: SkillCategory;
}

const { name, category } = Astro.props;

const categoryColors: Record<SkillCategory, string> = {
  languages: 'badge--languages',
  backend: 'badge--backend',
  frontend: 'badge--frontend',
  databases: 'badge--databases',
  devops: 'badge--devops',
  tools: 'badge--tools',
  ai: 'badge--ai'
};
---

<span class={`skill-badge ${categoryColors[category]}`}>
  {name}
</span>

<style>
  .skill-badge {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid;
    background: rgb(var(--color-primary) / 0.05);
    font-size: 0.875rem;
    white-space: nowrap;
    color: rgb(var(--color-text));
    transition: all 150ms var(--ease-out, ease-out);
    cursor: default;
  }

  .skill-badge:hover {
    background: rgb(var(--color-primary) / 0.12);
    transform: scale(1.05);
  }

  /* Category-specific border colors */
  .badge--languages {
    border-color: rgb(59 130 246 / 0.3); /* blue-500 */
  }

  .badge--backend {
    border-color: rgb(34 197 94 / 0.3); /* green-500 */
  }

  .badge--frontend {
    border-color: rgb(168 85 247 / 0.3); /* purple-500 */
  }

  .badge--databases {
    border-color: rgb(234 179 8 / 0.3); /* yellow-500 */
  }

  .badge--devops {
    border-color: rgb(249 115 22 / 0.3); /* orange-500 */
  }

  .badge--tools {
    border-color: rgb(107 114 128 / 0.3); /* gray-500 */
  }

  .badge--ai {
    border-color: rgb(236 72 153 / 0.3); /* pink-500 */
  }
</style>
