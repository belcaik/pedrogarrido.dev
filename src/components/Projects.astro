---
import { useTranslations, type Lang } from '../i18n';
import { Github, ExternalLink, FolderOpenDot } from '@lucide/astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface Project {
  name: string;
  role: string;
  year: string;
  description: string;
  tech: string[];
  github?: string;
  demo?: string;
  private: boolean;
}

const projects = t('projects.items') as unknown as Project[];
---

<section id="projects" class="section-container section-padding">
  <h2 class="section-title">
    <FolderOpenDot class="section-title-icon" size={24} />
    {t('projects.title')}
  </h2>

  <div class="grid-cards">
    {projects.map((project) => (
      <article class="card card-hover flex flex-col gap-5">
        <div class="flex justify-between items-start gap-4 md:flex-col md:items-start md:gap-3">
          <div class="flex-1">
            <h3 class="text-card-title text-text mb-1">{project.name}</h3>
            <p class="text-sm text-text-muted m-0">
              {project.role} • {project.year}
            </p>
          </div>
          {project.private && (
            <span class="private-badge">{t('projects.privateLabel')}</span>
          )}
        </div>

        <p class="text-text-muted leading-relaxed m-0 flex-1">{project.description}</p>

        <div class="flex flex-wrap gap-2">
          {project.tech.map((tech) => (
            <span class="tech-tag">{tech}</span>
          ))}
        </div>

        {!project.private && (project.github || project.demo) && (
          <div class="flex gap-4 pt-2 border-t border-border">
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                aria-label="View code on GitHub"
              >
                <Github size={18} />
                <span>{t('projects.viewCode')}</span>
              </a>
            )}
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link"
                aria-label="View live demo"
              >
                <ExternalLink size={18} />
                <span>{t('projects.viewDemo')}</span>
              </a>
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .private-badge {
    @apply bg-tag-bg text-tag-text px-3 py-1 rounded-xl text-xs font-semibold border border-border whitespace-nowrap uppercase tracking-wide;
  }

  .project-link {
    @apply flex items-center gap-2 text-text-muted no-underline text-sm font-medium transition-colors;
  }

  .project-link:hover {
    @apply text-primary;
  }

  .project-link :global(svg) {
    @apply w-[18px] h-[18px];
  }

  @media (max-width: 768px) {
    .text-card-title {
      @apply text-card-title-sm;
    }
  }
</style>
