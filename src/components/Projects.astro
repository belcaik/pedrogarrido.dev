---
import Diagram from "./Diagram.astro";
import { getProfile } from "../data/profile";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = getProfile(lang).projects.filter((project) => project.site);
---

<section class="sys" id="projects" aria-labelledby="projects-h">
  <p class="sys-label mono">03</p>
  <h2 id="projects-h">{t("projects.title")}</h2>
  <p class="sys-meta">{t("projects.meta")}</p>

  <div class="proj-list">
    {
      projects.map((project, index) => (
        <article class="proj" aria-labelledby={`project-${index}`}>
          <div>
            <span class="yr mono">{`${project.year} · ${project.tech[0]}`}</span>
            <h3 id={`project-${index}`}>
              {project.name}
              {project.wip && <span class="wip">{t("projects.wip")}</span>}
            </h3>
            <p>{project.description}</p>
            <a class="src" href={project.github} rel="noopener noreferrer">
              {t("projects.source")}
            </a>
          </div>
          {project.diagram && <Diagram diagram={project.diagram} lang={lang} />}
        </article>
      ))
    }
  </div>
</section>
