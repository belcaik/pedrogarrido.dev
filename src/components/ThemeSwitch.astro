---
import { Sun, Moon } from "@lucide/astro";
---

<button
    id="theme-toggle"
    class="flex glass w-10 h-10 p-2 rounded-lg cursor-pointer transition-all hover:scale-105"
    aria-label="Toggle theme"
    title="Toggle theme"
>
    <Sun class="icon sun-icon" />
    <Moon class="icon moon-icon" />
</button>

<script>
    function initThemeToggle() {
        const toggle = document.getElementById("theme-toggle");
        if (!toggle) return;

        function getThemePreference(): string {
            if (
                typeof localStorage !== "undefined" &&
                localStorage.getItem("theme")
            ) {
                return localStorage.getItem("theme")!;
            }
            return window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        }

        function setTheme(theme: string) {
            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }
            localStorage.setItem("theme", theme);
        }

        // Set initial theme
        setTheme(getThemePreference());

        // Toggle theme on button click
        toggle.addEventListener("click", () => {
            const currentTheme = document.documentElement.classList.contains(
                "dark",
            )
                ? "dark"
                : "light";
            setTheme(currentTheme === "dark" ? "light" : "dark");
        });

        // Listen for system theme changes
        window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", (e) => {
                if (!localStorage.getItem("theme")) {
                    setTheme(e.matches ? "dark" : "light");
                }
            });
    }

    // Run on initial page load
    initThemeToggle();

</script>

<style>
    .icon {
        @apply w-5 h-5 transition-all duration-200;
    }

    .sun-icon {
        color: #fbbf24;
    }

    .moon-icon {
        @apply absolute;
        color: #58a6ff;
    }

    /* Light mode: show sun, hide moon */
    :global(html:not(.dark)) .sun-icon {
        @apply opacity-100 rotate-0;
    }

    :global(html:not(.dark)) .moon-icon {
        @apply opacity-0 -rotate-90;
    }

    /* Dark mode: show moon, hide sun */
    :global(html.dark) .sun-icon {
        @apply opacity-0 rotate-90;
    }

    :global(html.dark) .moon-icon {
        @apply opacity-100 rotate-0;
    }
</style>
