---
import { getProfile, getResumeLink, getSystems } from "../data/profile";
import { useTranslations, type Lang } from "../i18n";
import ObfuscatedLink from "./ObfuscatedLink.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { identity, links } = getProfile(lang);
const [firstName, ...lastNames] = identity.name.split(" ");
const systems = getSystems(lang);
const resume = getResumeLink(lang);
---

<div class="intro">
  <div>
    <h1>
      {firstName}
      <br />
      {lastNames.join(" ")}
    </h1>
    <p class="lede">{identity.tagline}</p>
    <p class="avail">{identity.availabilityNote}</p>
    <ul class="links">
      <li>
        <ObfuscatedLink email={identity.email} ariaLabel={t("hero.emailAria") as string}>
          {t("hero.emailLink")}
        </ObfuscatedLink>
      </li>
      <li>
        <a href={links.linkedin.url} rel="noopener noreferrer">{links.linkedin.label}</a>
      </li>
      <li>
        <a href={links.github.url} rel="noopener noreferrer">{links.github.label}</a>
      </li>
      <li>
        <a href={resume.href} download={resume.download}>{t("resume.label")}</a>
      </li>
    </ul>
  </div>

  <nav class="sys-index" aria-label={t("systems.index") as string}>
    <ol>
      {
        systems.map((system, index) => (
          <li>
            <a href={`#${system.id}`}>
              <span class="mono">{String(index + 1).padStart(2, "0")}</span>
              <span>
                <strong>{system.company}</strong>
                <span class="d">{`${system.tagline ?? ""} · ${system.years}`}</span>
              </span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="#projects">
          <span class="mono">03</span>
          <span>
            <strong>{t("projects.index")}</strong>
            <span class="d">{t("projects.indexDetail")}</span>
          </span>
        </a>
      </li>
    </ol>
  </nav>
</div>
