---
import { useTranslations, type Lang, getLocalizedPath } from "../i18n";
import { GithubIcon, LinkedinIcon, MailIcon } from "../assets/icons";


interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="hero">
  <h1>
    {t("hero.greeting")}

    <span class="hero-name">
      {t("hero.name")}
    </span>
  </h1>
  <h2>
    {t("hero.experience")}
    <span class="hero-title">{t("hero.title")}</span>
    {t("hero.subtitle")}
    <br />
    {t('hero.location')}
  </h2>

  <div>
    <a class="cta-button">
      <MailIcon 
      class="hero-icon"
      />
      
      {t("hero.cta")}
    </a>
    <a class="cta-button">

      <LinkedinIcon 
      class="hero-icon"
      />
      {t("hero.linkedin")}
    </a>
    <a class="cta-button">
      <GithubIcon 
      class="hero-icon"
      />
      {t("hero.github")}
    </a>
  </div>
</section>

<style>

.hero-icon{
  width: 1.2rem;
  height: 1.2rem;
  vertical-align: sub;
  margin-right: 0.5rem;
  fill: white;
}

.hero{
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  text-align: left;
  padding: 4rem 1rem;
}

.hero-name {
  font-weight: bold;
  background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-top: 0.5rem;
}

.hero-title {
  font-weight: bold;
  background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.cta-button {
  display: inline-block;
  margin-top: 1.5rem;
  margin-right: 1rem;
  padding: 0.5rem 1.25rem;
  background: rgba(37, 99, 235, 0.5);
  color: black;
  text-decoration: none;
  border-radius: 2em;
  outline: solid 2px #2563eb;
  transition: background 0.3s ease;
} 



</style>
