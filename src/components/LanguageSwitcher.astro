---
import { languages, useTranslations, type Lang } from "../i18n";
import { Globe, ChevronDown } from "@lucide/astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

function getLocalizedPath(targetLang: Lang): string {
  const pathParts = currentPath.split("/").filter(Boolean);
  if (pathParts.length > 0 && pathParts[0] in languages) {
    pathParts[0] = targetLang;
  } else {
    pathParts.unshift(targetLang);
  }
  return "/" + pathParts.join("/");
}
---

<div class="language-selector">
  <button
    class="selector-toggle"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-label={`${t("language.current") as string}: ${lang.toUpperCase()}`}
  >
    <Globe size={16} />
    <span class="code">{lang.toUpperCase()}</span>
    <ChevronDown class="dropdown-icon" size={14} />
  </button>
  <ul class="dropdown" role="listbox" aria-label={t("language.select") as string}>
    {
      Object.entries(languages).map(([code, name]) => (
        <li role="option" aria-selected={lang === code}>
          <a
            href={getLocalizedPath(code as Lang)}
            class:list={["dropdown-item", { active: lang === code }]}
            aria-label={`${t("language.switchTo") as string} ${name}`}
          >
            <span class="code">{code.toUpperCase()}</span>
            <span>{name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  function initLanguageSelector() {
    const selector = document.querySelector(".language-selector");
    const toggle = document.querySelector(".selector-toggle");

    if (!selector || !toggle) return;

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", (!isExpanded).toString());
      selector.classList.toggle("open");
    });

    document.addEventListener("click", (e) => {
      if (!selector.contains(e.target as Node)) {
        toggle.setAttribute("aria-expanded", "false");
        selector.classList.remove("open");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        toggle.setAttribute("aria-expanded", "false");
        selector.classList.remove("open");
      }
    });
  }

  // Run on initial page load
  initLanguageSelector();
</script>

<style>
  .language-selector {
    position: relative;
  }

  .selector-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 0.85rem;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--edge);
    border-radius: 4px;
    cursor: pointer;
  }

  .selector-toggle:hover {
    border-color: var(--ink);
  }

  .dropdown-icon {
    transition: transform 200ms ease-out;
  }

  .language-selector.open .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 20;
    min-width: 140px;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--edge);
    border-radius: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem);
    transition: opacity 200ms ease-out, transform 200ms ease-out, visibility 200ms;
  }

  .language-selector.open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0 0.75rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .dropdown-item:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .dropdown-item.active {
    color: var(--accent);
    font-weight: 700;
  }

  .code {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    font-weight: 500;
  }
</style>
