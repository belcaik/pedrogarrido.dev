---
import { languages, type Lang } from "../i18n";
import { Globe, ChevronDown } from "@lucide/astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;

function getLocalizedPath(targetLang: Lang): string {
  const pathParts = currentPath.split("/").filter(Boolean);
  if (pathParts.length > 0 && pathParts[0] in languages) {
    pathParts[0] = targetLang;
  } else {
    pathParts.unshift(targetLang);
  }
  return "/" + pathParts.join("/");
}
---

<div class="language-selector relative">
  <button
    class="selector-toggle glass flex items-center gap-2 py-2 px-3 rounded-lg cursor-pointer font-medium text-text transition-all"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-label={`Select language, current: ${lang.toUpperCase()}`}
    onclick=""
  >
    <Globe size={18} />
    <span class="text-sm font-semibold">{lang.toUpperCase()}</span>
    <ChevronDown class="dropdown-icon transition-transform duration-200" size={16} />
  </button>
  <ul class="dropdown" role="listbox" aria-label="Select language">
    {
      Object.entries(languages).map(([code, name]) => (
        <li role="option" aria-selected={lang === code} class="m-0">
          <a
            href={getLocalizedPath(code as Lang)}
            class:list={["dropdown-item", { active: lang === code }]}
            aria-label={`Switch to ${name}`}
          >
            <span class="text-sm font-semibold">{code.toUpperCase()}</span>
            <span class="text-sm opacity-80">{name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  function initLanguageSelector() {
    const selector = document.querySelector(".language-selector");
    const toggle = document.querySelector(".selector-toggle");

    if (!selector || !toggle) return;

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", (!isExpanded).toString());
      selector.classList.toggle("open");
    });

    document.addEventListener("click", (e) => {
      if (!selector.contains(e.target as Node)) {
        toggle.setAttribute("aria-expanded", "false");
        selector.classList.remove("open");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        toggle.setAttribute("aria-expanded", "false");
        selector.classList.remove("open");
      }
    });
  }

  // Run on initial page load
  initLanguageSelector();

  // Run on subsequent navigations (View Transitions)
  document.addEventListener("astro:page-load", initLanguageSelector);
</script>

<style>
  .language-selector.open .dropdown-icon {
    @apply rotate-180;
  }

  .dropdown {
    @apply absolute top-[calc(100%+0.5rem)] right-0 min-w-[140px] p-2 m-0 list-none rounded-lg opacity-0 invisible -translate-y-2 transition-all duration-200;
    background: rgba(var(--color-surface), 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(var(--color-border));
    box-shadow: 0 4px 16px rgba(var(--shadow-color), 0.15);
  }

  .language-selector.open .dropdown {
    @apply opacity-100 visible translate-y-0;
  }

  .dropdown-item {
    @apply flex items-center gap-3 py-2 px-3 no-underline text-text rounded-md transition-all duration-150;
  }

  .dropdown-item:hover {
    @apply bg-text/10;
  }

  .dropdown-item.active {
    @apply bg-primary text-white;
  }
</style>
