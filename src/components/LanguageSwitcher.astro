---
import { languages, type Lang } from "../i18n";
import { LocalizationIcon, DropdownIcon } from "../assets/icons";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;

function getLocalizedPath(targetLang: Lang): string {
  const pathParts = currentPath.split("/").filter(Boolean);
  if (pathParts.length > 0 && pathParts[0] in languages) {
    pathParts[0] = targetLang;
  } else {
    pathParts.unshift(targetLang);
  }
  return "/" + pathParts.join("/");
}
---

<div class="language-selector">
  <button
    class="selector-toggle"
    aria-expanded="false"
    aria-haspopup="listbox"
    onclick=""
  >
    <LocalizationIcon class="localization-icon" />
    <span class="current-lang">{lang.toUpperCase()}</span>
    <DropdownIcon class="dropdown-icon" />
  </button>
  <ul class="dropdown" role="listbox" aria-label="Select language">
    {
      Object.entries(languages).map(([code, name]) => (
        <li role="option" aria-selected={lang === code}>
          <a
            href={getLocalizedPath(code as Lang)}
            class:list={["dropdown-item", { active: lang === code }]}
          >
            <span class="lang-code">{code.toUpperCase()}</span>
            <span class="lang-name">{name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  function initLanguageSelector() {
    const selector = document.querySelector(".language-selector");
    const toggle = document.querySelector(".selector-toggle");

    if (!selector || !toggle) return;

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isExpanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", (!isExpanded).toString());
      selector.classList.toggle("open");
    });

    document.addEventListener("click", (e) => {
      if (!selector.contains(e.target as Node)) {
        toggle.setAttribute("aria-expanded", "false");
        selector.classList.remove("open");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        toggle.setAttribute("aria-expanded", "false");
        selector.classList.remove("open");
      }
    });
  }

  // Run on initial page load
  initLanguageSelector();

  // Run on subsequent navigations (View Transitions)
  document.addEventListener("astro:page-load", initLanguageSelector);
</script>

<style>
  .language-selector {
    position: relative;
  }

  .selector-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgba(var(--color-surface), 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(var(--color-border));
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(var(--shadow-color), 0.1);
    cursor: pointer;
    font-weight: 500;
    color: rgb(var(--color-text));
    transition: all 0.2s ease;
  }

  .selector-toggle:hover {
    background: rgba(var(--color-surface), 1);
    box-shadow: 0 4px 12px rgba(var(--shadow-color), 0.15);
  }

  .dropdown-icon {
    transition: transform 0.2s ease;
  }

  .language-selector.open .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 140px;
    padding: 0.5rem;
    margin: 0;
    list-style: none;
    background: rgba(var(--color-surface), 0.95);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(var(--color-border));
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(var(--shadow-color), 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.2s ease;
  }

  .language-selector.open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown li {
    margin: 0;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    color: rgb(var(--color-text));
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .dropdown-item:hover {
    background: rgba(var(--color-text), 0.1);
  }

  .dropdown-item.active {
    background: rgb(var(--color-primary));
    color: white;
  }

  .lang-code {
    font-weight: 600;
    font-size: 0.875rem;
  }

  .lang-name {
    font-size: 0.875rem;
    opacity: 0.8;
  }
</style>
