---
import { useTranslations, type Lang } from '../i18n';
import { ToolCase } from '@lucide/astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = ['languages', 'backend', 'frontend', 'databases', 'devops', 'tools'];
---

<section id="skills" class="section-container section-padding">
  <h2 class="section-title">
    <ToolCase class="section-title-icon" size={24} />
    {t('skills.title')}
  </h2>

  <div class="grid-skills">
    {categories.map((category) => {
      const items = t(`skills.categories.${category}.items`) as string[];
      return (
        <div class="card card-hover">
          <h3 class="category-title">{t(`skills.categories.${category}.title`)}</h3>
          <div class="flex flex-wrap gap-2">
            {items.map((item: string) => (
              <span class="tech-tag tech-tag-hover">{item}</span>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .category-title {
    @apply text-lg font-semibold mb-4 text-text flex items-center gap-2;
  }

  .category-title::before {
    content: '';
    @apply inline-block w-1 h-[1.125rem] bg-primary rounded-sm;
  }
</style>
