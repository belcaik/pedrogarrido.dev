---
import ObfuscatedEmail from "./ObfuscatedEmail.astro";
import { getProfile, getResumeLink } from "../data/profile";
import { useTranslations, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { education, identity, links } = getProfile(lang);
const resume = getResumeLink(lang);
---

<section class="sys" id="contact" aria-labelledby="contact-h">
  <div class="end">
    <div>
      <h2 class="sub-title" id="education-h">{t("education.title")}</h2>
      <ul class="edu">
        {
          education.map((item) => (
            <li>
              <span class="mono">{item.date}</span>
              {`${item.degree}, ${item.institution}. `}
              {item.status ?? item.honors}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="sub-title" id="contact-h">{t("contact.title")}</h2>
      <p>{`${identity.availabilityNote} ${identity.contactLead}`}</p>
      <ObfuscatedEmail email={identity.email} lang={lang} class="mail" />
      <ul class="links">
        <li>
          <a href={links.linkedin.url} rel="noopener noreferrer">{links.linkedin.display}</a>
        </li>
        <li>
          <a href={links.github.url} rel="noopener noreferrer">{links.github.display}</a>
        </li>
        <li>
          <a href={resume.href} download={resume.download}>{t("resume.label")}</a>
        </li>
      </ul>
    </div>
  </div>
</section>
