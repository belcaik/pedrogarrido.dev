---
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import Honeypot from "../components/Honeypot.astro";
import { useTranslations, type Lang, languages, defaultLang } from "../i18n";
import "../styles/global.css";
import "../styles/animations.css";

interface Props {
    lang: Lang;
    title?: string;
    isRoot?: boolean;
}

const { lang, title, isRoot = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title || t("meta.title") as string;
const description = t("meta.description") as string;

const siteUrl = Astro.site?.href || "https://pedrogarrido.dev";
const currentPath = Astro.url.pathname;

// Canonical URL: root page is canonical for default lang home, otherwise use current URL
const canonicalUrl = isRoot
    ? siteUrl
    : new URL(currentPath, siteUrl).href;

// OG Image - using a static image in public folder
const ogImage = new URL("/og-image.png", siteUrl).href;

const alternateLinks = Object.keys(languages).map((l) => {
    const pathParts = currentPath.split("/").filter(Boolean);
    if (pathParts.length > 0 && pathParts[0] in languages) {
        pathParts[0] = l;
    } else if (isRoot) {
        // For root page, alternate links point to language-specific pages
        return {
            lang: l,
            href: new URL("/" + l + "/", siteUrl).href,
        };
    }
    return {
        lang: l,
        href: new URL("/" + pathParts.join("/") + "/", siteUrl).href,
    };
});

// x-default points to root for language negotiation
const xDefaultHref = siteUrl;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />

        <!-- Fonts - JetBrains Mono (display/headings) + DM Sans (body) -->
        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalUrl} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:site_name" content="Pedro Garrido" />
        <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <!-- Anti-scraping measures (allowing indexing but blocking AI training) -->
        <meta name="robots" content="index, follow, noai, noimageai" />
        <meta name="googlebot" content="index, follow, notranslate" />

        <title>{pageTitle}</title>

        <!-- Alternate language versions -->
        {
            alternateLinks.map((link) => (
                <link rel="alternate" hreflang={link.lang} href={link.href} />
            ))
        }
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    </head>
    <body>
        <!-- Honeypot trap for bots -->
        <Honeypot />
        <div class="fixed inset-0 z-0 background-gradient"></div>
        <div class="min-h-screen w-full relative">
            <nav
                class="sticky top-0 z-[1000] bg-background/80 backdrop-blur-glass border-b border-border py-4"
            >
                <div
                    class="section-container flex items-center justify-between gap-8 md:gap-4"
                >
                    <a
                        href={`/${lang}`}
                        class="text-xl font-display font-bold text-text no-underline transition-colors hover:text-primary"
                    >
                        Pedro Garrido
                    </a>

                    <div
                        class="hidden md:flex items-center gap-8 flex-1 justify-center"
                    >
                        <a href="#experience" class="nav-link"
                            >{t("nav.experience")}</a
                        >
                        <a href="#projects" class="nav-link"
                            >{t("nav.projects")}</a
                        >
                        <a href="#about" class="nav-link">{t("nav.about")}</a>
                        <a href="#contact" class="nav-link"
                            >{t("nav.contact")}</a
                        >
                    </div>

                    <div class="flex items-center gap-2">
                        <LanguageSwitcher lang={lang} />
                    </div>
                </div>
            </nav>
            <slot />
        </div>
        <script src="../scripts/scroll-animations.ts"></script>
    </body>
</html>

<style>
    .nav-link {
        @apply text-text-muted no-underline text-[0.9375rem] font-display font-medium transition-colors relative;
    }

    .nav-link:hover {
        @apply text-primary;
    }

    .nav-link::after {
        content: "";
        @apply absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all duration-200;
    }

    .nav-link:hover::after {
        @apply w-full;
    }
</style>
