---
import Header from "../components/Header.astro";
import Honeypot from "../components/Honeypot.astro";
import { useTranslations, type Lang, languages, defaultLang } from "../i18n";
import "../styles/global.css";
import { getProfile } from "../data/profile";

interface Props {
    lang: Lang;
    title?: string;
    isRoot?: boolean;
}

const { lang, title, isRoot = false } = Astro.props;
const t = useTranslations(lang);
const { identity } = getProfile(lang);
const pageTitle = title || identity.metaTitle;
const description = identity.metaDescription;

const siteUrl = Astro.site?.href || "https://pedrogarrido.dev";
const currentPath = Astro.url.pathname;

// Canonical URL: root page is canonical for default lang home, otherwise use current URL
const canonicalUrl = isRoot
    ? siteUrl
    : new URL(currentPath, siteUrl).href;

// OG Image - using a static image in public folder
const ogImage = new URL("/og-image.png", siteUrl).href;

const alternateLinks = Object.keys(languages).map((l) => {
    const pathParts = currentPath.split("/").filter(Boolean);
    if (pathParts.length > 0 && pathParts[0] in languages) {
        pathParts[0] = l;
    } else if (isRoot) {
        // For root page, alternate links point to language-specific pages
        return {
            lang: l,
            href: new URL("/" + l + "/", siteUrl).href,
        };
    }
    return {
        lang: l,
        href: new URL("/" + pathParts.join("/") + "/", siteUrl).href,
    };
});

// x-default points to root for language negotiation
const xDefaultHref = siteUrl;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="color-scheme" content="light dark" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />

        <!-- Runs before first paint so the saved theme never flashes -->
        <script is:inline>
            document.documentElement.classList.add("js");
            try {
                var savedTheme = localStorage.getItem("pg-theme");
                if (savedTheme) document.documentElement.dataset.theme = savedTheme;
            } catch (e) {}
        </script>

        <!-- Fonts - Schibsted Grotesk (text and headings) + JetBrains Mono (small labels) -->
        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalUrl} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:site_name" content={identity.name} />
        <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <!-- Anti-scraping measures (allowing indexing but blocking AI training) -->
        <meta name="robots" content="index, follow, noai, noimageai" />
        <meta name="googlebot" content="index, follow, notranslate" />

        <title>{pageTitle}</title>

        <!-- Alternate language versions -->
        {
            alternateLinks.map((link) => (
                <link rel="alternate" hreflang={link.lang} href={link.href} />
            ))
        }
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    </head>
    <body>
        <!-- Honeypot trap for bots -->
        <Honeypot />
        <a class="skip" href="#main">{t("nav.skip")}</a>
        <div class="wrap">
            <Header lang={lang} />
            <slot />
        </div>
    </body>
</html>
